{
  "_version": "1.40.0",
  "sap.app": {
    "id": "itsm.ui",
    "type": "application",
    "title": "ITSM",
    "dataSources": {
      "itsmService": {
        "uri": "/odata/v4/itsm/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "applicationVersion": { "version": "1.0.0" }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "itsm.ui.view.App",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
  "sap.m": {},
  "sap.ui.core": {},
  "sap.ui.layout": {},
  "sap.ui.unified": {},
  "sap.viz": {}
}
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        
        "settings": {
  "bundleName": "itsm.ui.i18n.i18n",
  "supportedLocales": [""],
  "fallbackLocale": ""
}
      },
      "": {
        "dataSource": "itsmService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$auto",
          "updateGroupId": "itsmGroup"
        }
      }
    },
    "resources": {
      "css": [{ "uri": "css/style.css" }]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "itsm.ui.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
  { "pattern": "", "name": "dashboard", "target": "dashboard" },
  { "pattern": "tickets", "name": "list", "target": "list" },
  { "pattern": "create", "name": "create", "target": "main" },
  { "pattern": "ticket/{id}", "name": "detail", "target": "main" },
  { "pattern": "analytics", "name": "analytics", "target": "analytics" }
],
"targets": {
  "dashboard": { "viewName": "Dashboard", "viewId": "dashboard" },
  "list": { "viewName": "TicketList", "viewId": "list" },
  "main": { "viewName": "Main", "viewId": "main" },
  "analytics": { "viewName": "Analytics", "viewId": "analytics" }
}
    }
  }
}
