<mvc:View
  controllerName="itsm.ui.controller.Analytics"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:vizData="sap.viz.ui5.data"
  xmlns:vizFeed="sap.viz.ui5.controls.common.feeds"
  displayBlock="true">
 
  <Page id="analyticsPage" showHeader="false" backgroundDesign="Transparent" class="appBg densePage">
 
    <!-- ===== same styled app header as the other pages: back button (left) · logo (click = home) · title (center) · actions (right) ===== -->
    <Bar class="appHeader">
      <contentLeft>
        <Button icon="sap-icon://nav-back" type="Transparent"
                tooltip="Back to dashboard"
                press=".onGoDashboard"
                class="sapUiTinyMarginEnd"/>
        <Image src="images/ccentrik.png" height="30px" densityAware="false" class="appLogo" press=".onGoDashboard"/>
      </contentLeft>
      <contentMiddle>
        <Title text="Service Desk Analytics" class="appHeaderTitle"/>
      </contentMiddle>
      <contentRight>
        <Avatar initials="{user>/initials}" displaySize="XS" tooltip="{user>/name}"
                class="profileAvatar" press=".onProfilePress"/>
      </contentRight>
    </Bar>
 
    <!-- ===== top KPI row: each tile is something to act on, not just a
         raw count — same tile styling/accents as the dashboard's KPI
         tiles, but a fixed set (not data-templated) so the classes are
         just written directly instead of synced from the controller. ===== -->
    <HBox class="tileRow sapUiTinyMarginTop" width="100%">
      <VBox class="kpiTileWrap">
        <layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
        <GenericTile header="At Risk (SLA due soon)" frameType="OneByHalf" width="100%" state="Loaded" class="kpiTile acc3">
          <TileContent><NumericContent value="{an>/stats/atRisk}" valueColor="Critical" icon="sap-icon://alert" withMargin="false"/></TileContent>
        </GenericTile>
        <Text id="atRiskBadge" class="trendBadge"/>
      </VBox>
      <VBox class="kpiTileWrap">
        <layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
        <GenericTile header="Breached" frameType="OneByHalf" width="100%" state="Loaded" class="kpiTile acc4">
          <TileContent><NumericContent value="{an>/stats/breached}" valueColor="Error" icon="sap-icon://message-error" withMargin="false"/></TileContent>
        </GenericTile>
        <Text id="breachedBadge" class="trendBadge"/>
      </VBox>
      <VBox class="kpiTileWrap">
        <layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
        <GenericTile header="SLA Compliance" frameType="OneByHalf" width="100%" state="Loaded" class="kpiTile acc6">
          <TileContent><NumericContent value="{an>/stats/compliancePercent}" scale="%" valueColor="Good" icon="sap-icon://accept" withMargin="false"/></TileContent>
        </GenericTile>
      </VBox>
      <VBox class="kpiTileWrap">
        <layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
        <GenericTile header="Oldest Open Ticket" frameType="OneByHalf" width="100%" state="Loaded" class="kpiTile acc2">
          <TileContent><NumericContent value="{an>/stats/oldestOpenAge}" valueColor="Neutral" icon="sap-icon://history" withMargin="false"/></TileContent>
        </GenericTile>
      </VBox>
      <VBox class="kpiTileWrap">
        <layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
        <GenericTile header="Avg Resolution Time" frameType="OneByHalf" width="100%" state="Loaded" class="kpiTile acc1">
          <TileContent><NumericContent value="{an>/stats/avgResolution}" valueColor="Neutral" icon="sap-icon://trend-up" withMargin="false"/></TileContent>
        </GenericTile>
      </VBox>
      <VBox class="kpiTileWrap">
        <layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
        <GenericTile header="Unassigned" frameType="OneByHalf" width="100%" state="Loaded" class="kpiTile acc5">
          <TileContent><NumericContent value="{an>/stats/unassigned}" valueColor="Critical" icon="sap-icon://employee" withMargin="false"/></TileContent>
        </GenericTile>
        <Text id="unassignedBadge" class="trendBadge"/>
      </VBox>
    </HBox>
 
    <!-- ===== split: trends (left, wide) + category shortcut tiles (right,
         narrow) — same split layout and card styling as the dashboard's
         table/chart row, so the two pages read as one family. ===== -->
    <HBox class="splitRow sapUiTinyMarginTop" wrap="Wrap" width="100%" alignItems="Stretch">
 
      <!-- TRENDS + AT RISK: the "act on this now" list sits right under
           the chart in the same card, instead of its own section — less
           space used, more visible without scrolling. -->
      <VBox class="tablePane">
        <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
          <Text text="TICKETS: CREATED VS RESOLVED" class="sectionPill"/>
          <Select id="trendRangeSelect" width="8.5rem" selectedKey="14" change=".onTrendRangeChange">
            <core:Item key="7" text="Last 7 Days"/>
            <core:Item key="14" text="Last 14 Days"/>
            <core:Item key="30" text="Last 30 Days"/>
          </Select>
        </HBox>
        <viz:VizFrame
          id="trendsChart"
          vizType="column"
          width="100%"
          height="240px"
          uiConfig="{applicationSet:'fiori'}">
          <viz:dataset>
            <vizData:FlattenedDataset data="{an>/trendData}">
              <vizData:dimensions>
                <vizData:DimensionDefinition name="Date" value="{an>date}"/>
              </vizData:dimensions>
              <vizData:measures>
                <vizData:MeasureDefinition name="Created" value="{an>created}"/>
                <vizData:MeasureDefinition name="Resolved" value="{an>resolved}"/>
              </vizData:measures>
            </vizData:FlattenedDataset>
          </viz:dataset>
          <viz:feeds>
            <vizFeed:FeedItem uid="valueAxis" type="Measure" values="Created"/>
            <vizFeed:FeedItem uid="valueAxis" type="Measure" values="Resolved"/>
            <vizFeed:FeedItem uid="categoryAxis" type="Dimension" values="Date"/>
          </viz:feeds>
        </viz:VizFrame>
 
        <Text text="AT RISK — SLA DUE SOON" class="sectionPill sapUiTinyMarginTop"/>
        <List items="{an>/atRisk}" noDataText="Nothing at risk right now." class="atRiskList">
          <CustomListItem type="Navigation" press=".onAtRiskPress">
            <HBox justifyContent="SpaceBetween" alignItems="Center" class="atRiskRow" width="100%">
              <VBox>
                <Text text="{an>ticketNumber}" class="atRiskNumber"/>
                <Text text="{an>shortDescription}" class="atRiskDesc"/>
              </VBox>
              <VBox alignItems="End">
                <ObjectStatus text="{an>priority}" state="Warning"/>
                <Text text="{an>dueText}" class="atRiskDue"/>
              </VBox>
            </HBox>
          </CustomListItem>
        </List>
      </VBox>
 
      <!-- TICKETS: same data as the dashboard's ticket table, trimmed to
           just the columns useful in this narrow card (no fixed widths,
           so text wraps instead of needing a horizontal scroll).
           Collapsible, same as the dashboard's chart card. -->
      <VBox id="tilesPane" class="chartPane">
        <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
          <Text text="TICKETS" class="sectionPill"/>
          <Button id="tilesToggleBtn" icon="sap-icon://slim-arrow-right" type="Transparent"
                  tooltip="Collapse" press=".onToggleTiles" class="chartToggleBtn"/>
        </HBox>
        <VBox class="chartBody">
          <Table
            id="sideTicketTable"
            inset="false"
            growing="true"
            growingThreshold="50"
            items="{
              path: '/Tickets',
              parameters: {
                $orderby: 'createdAt desc'
              }
            }"
            noDataText="No tickets yet.">
 
            <columns>
              <Column><Text text="Ticket #"/></Column>
              <Column><Text text="Description"/></Column>
              <Column><Text text="Status"/></Column>
              <Column><Text text="Priority"/></Column>
            </columns>
 
            <items>
              <ColumnListItem type="Navigation" press=".onTicketPress">
                <cells>
                  <Text text="{ticketNumber}"/>
                  <Text text="{shortDescription}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatStatusName'}" state="{path: 'status', formatter: '.formatStatusState'}"/>
                  <ObjectStatus text="{path: 'priority', formatter: '.formatPriorityName'}" state="{path: 'priority', formatter: '.formatPriorityState'}"/>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </VBox>
      </VBox>
 
    </HBox>
 
    <!-- ===== SLA compliance: met vs breached overall, then a per-priority
         breakdown — same "response/resolution window" logic the ticket
         SLA badges use elsewhere, rolled up into counts instead of a
         per-ticket status. ===== -->
    <VBox class="sectionCard sapUiTinyMarginTop">
      <Text text="SLA COMPLIANCE" class="sectionPill"/>
      <HBox class="slaSummaryRow" wrap="Wrap">
        <VBox class="slaStat" alignItems="Center">
          <Text text="{an>/slaSummary/met}" class="slaStatValue slaMet"/>
          <Text text="Met / On Track" class="slaStatLabel"/>
        </VBox>
        <VBox class="slaStat" alignItems="Center">
          <Text text="{an>/slaSummary/breached}" class="slaStatValue slaBreached"/>
          <Text text="Breached" class="slaStatLabel"/>
        </VBox>
      </HBox>
      <List items="{an>/slaSummary/byPriority}" class="sapUiTinyMarginTop catList" noDataText="No SLA data yet.">
        <CustomListItem>
          <VBox class="catRow">
            <HBox justifyContent="SpaceBetween">
              <Text text="{an>label}" class="catName"/>
              <Text text="{an>met} met / {an>breached} breached" class="catCount"/>
            </HBox>
            <ProgressIndicator percentValue="{an>percent}" displayValue="{an>percent}% met" class="catBar" state="{an>state}"/>
          </VBox>
        </CustomListItem>
      </List>
    </VBox>
  </Page>
</mvc:View>
 
 