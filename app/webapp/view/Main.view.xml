<mvc:View
  controllerName="itsm.ui.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  xmlns:u="sap.ui.unified"
  xmlns:upload="sap.m.upload"
  displayBlock="true">
 
  <Page id="page" showHeader="false" backgroundDesign="Transparent" class="appBg densePage">
 
    <!-- ===== same styled app header as the dashboard: back button (left) · logo (click = home) · title (center) · actions (right) =====
         sap.m.Bar is single-line only in this theme (its Left/Middle/Right
         containers are height-locked); the subtitle lives just below it in
         normal page flow instead of fighting the bar for vertical space. -->
    <Bar class="appHeader">
      <contentLeft>
        <Button icon="sap-icon://nav-back" type="Transparent"
                tooltip="Back to dashboard"
                visible="{ui>/showBack}"
                press=".onBack"
                class="sapUiTinyMarginEnd"/>
        <Image src="images/ccentrik.png" height="30px" densityAware="false" class="appLogo" press=".onGoDashboard"/>
      </contentLeft>
      <contentMiddle>
        <Title text="Service Desk" class="appHeaderTitle"/>
      </contentMiddle>
      <contentRight>
        <Button text="Edit" class="saveBtn sapUiTinyMarginEnd" visible="{ui>/showEdit}" press=".onEdit"/>
        <Button text="Save" class="saveBtn sapUiTinyMarginEnd" visible="{ui>/showSave}" press=".onSave"/>
        <Button text="Submit" class="submitBtn" visible="{ui>/showSubmit}" press=".onSubmit"/>
        <Avatar initials="{user>/initials}" displaySize="XS" tooltip="{user>/name}"
                class="profileAvatar sapUiTinyMarginBegin" press=".onProfilePress"/>
      </contentRight>
    </Bar>
    <!-- Ticket id (or "New Ticket" before one's assigned) now lives here,
         left-aligned below the header, since the header title itself is
         the fixed app name across every page. -->
    <VBox class="pageSubtitleBlock">
      <Text text="{ui>/ticketLabel}" class="pageTicketId"/>
      <Text text="{ui>/subtitle}" class="pageSubtitle"/>
    </VBox>
 
    <!-- Tabs act as in-page navigation: selecting one scrolls to its section. -->
    <IconTabHeader id="tabs" mode="Inline" backgroundDesign="Transparent" select=".onTabSelect" class="sapUiSmallMarginTop">
      <items>
        <IconTabFilter text="Details" key="details"/>
        <IconTabFilter text="Description" key="description"/>
        <IconTabFilter text="Attachments" key="attachments"/>
        <IconTabFilter text="History" key="history"/>
      </items>
    </IconTabHeader>
 
    <VBox id="sections">
 
        <!-- DETAILS -->
        <VBox id="secDetails">
 
          <!-- ===== 1. GENERAL DATA ===== -->
          <Panel class="sectionCard" headerText="General Data" expandable="true" expanded="true">
            <f:SimpleForm editable="{ui>/formEditable}" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
 
              <Label text="Ticket #"/>
              <Input value="{parts: ['ticketNumber', 'ui>/ticketNumberPreview'], formatter: '.formatTicketNumberDisplay'}" editable="false" placeholder="Auto-generated"/>

              <Label text="Ticket Type"/>
              <Select selectedKey="{ticketType_ID}" forceSelection="false" enabled="{ui>/formEditable}"
                      items="{ path: '/LookupValues', sorter: [{ path: 'sequence' }], filters: [{ path: 'lookupType', operator: 'EQ', value1: 'TICKET_TYPE' }, { path: 'isActive', operator: 'EQ', value1: true }] }">
                <core:Item key="{ID}" text="{name}"/>
              </Select>

              <Label text="Language"/>
              <Select selectedKey="{language_ID}" forceSelection="false" enabled="{ui>/formEditable}"
                      items="{ path: '/LookupValues', sorter: [{ path: 'sequence' }], filters: [{ path: 'lookupType', operator: 'EQ', value1: 'LANGUAGE' }, { path: 'isActive', operator: 'EQ', value1: true }] }">
                <core:Item key="{ID}" text="{name}"/>
              </Select>

              <Label text="Standard Ticket"/>
              <CheckBox selected="{isStandard}" enabled="{ui>/formEditable}"/>
 
              <Label text="Reported By"/>
              <Select selectedKey="{reportedBy_ID}" forceSelection="false" enabled="{ui>/formEditable}"
                      items="{ path: '/Users', sorter: [{ path: 'name' }], filters: [{ path: 'isActive', operator: 'EQ', value1: true }] }">
                <core:Item key="{ID}" text="{name}"/>
              </Select>
 
              <Label text="Support Team"/>
              <Select selectedKey="{supportTeam_ID}" forceSelection="false" enabled="{ui>/formEditable}"
                      items="{ path: '/SupportTeams', sorter: [{ path: 'name' }], filters: [{ path: 'isActive', operator: 'EQ', value1: true }] }">
                <core:Item key="{ID}" text="{name}"/>
              </Select>
 
              <Label text="Message Processor"/>
              <Select selectedKey="{messageProcessor_ID}" forceSelection="false" enabled="{ui>/formEditable}"
                      items="{ path: '/Users', sorter: [{ path: 'name' }], filters: [{ path: 'isActive', operator: 'EQ', value1: true }] }">
                <core:Item key="{ID}" text="{name}"/>
              </Select>
 
            </f:SimpleForm>
 
            <Label text="Description" required="true" class="sapUiSmallMarginTop"/>
            <TextArea rows="3" width="100%" editable="{ui>/formEditable}"
              value="{shortDescription}"
              placeholder="Provide the precise summary of the ticket."/>
          </Panel>
 
          <!-- ===== 2. CATEGORY (existing implementation, unchanged) ===== -->
          <Panel class="sectionCard" headerText="Category Assignment" expandable="true" expanded="true">
            <f:SimpleForm editable="{ui>/formEditable}" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
 
              <!-- Cascading categories. Each level is filled by the controller
                   from the children of the level above, so depth and content
                   come purely from master data. -->
              <Label text="Category 1"/>
              <Select id="selCategory1" selectedKey="{category1_ID}"
                      items="{cat>/levels/0/items}"
                      enabled="{cat>/levels/0/enabled}"
                      busy="{cat>/levels/0/busy}"
                      busyIndicatorDelay="0"
                      forceSelection="false"
                      width="100%"
                      change=".onCategoryChange">
                <core:Item key="{cat>ID}" text="{cat>name}"/>
              </Select>
              <Text text="No subcategories available" visible="{cat>/levels/0/noChildren}" class="noSubText"/>
 
              <Label text="Category 2"/>
              <Select id="selCategory2" selectedKey="{category2_ID}"
                      items="{cat>/levels/1/items}"
                      enabled="{cat>/levels/1/enabled}"
                      busy="{cat>/levels/1/busy}"
                      busyIndicatorDelay="0"
                      forceSelection="false"
                      width="100%"
                      change=".onCategoryChange">
                <core:Item key="{cat>ID}" text="{cat>name}"/>
              </Select>
              <Text text="No subcategories available" visible="{cat>/levels/1/noChildren}" class="noSubText"/>
 
              <Label text="Category 3"/>
              <Select id="selCategory3" selectedKey="{category3_ID}"
                      items="{cat>/levels/2/items}"
                      enabled="{cat>/levels/2/enabled}"
                      busy="{cat>/levels/2/busy}"
                      busyIndicatorDelay="0"
                      forceSelection="false"
                      width="100%"
                      change=".onCategoryChange">
                <core:Item key="{cat>ID}" text="{cat>name}"/>
              </Select>
              <Text text="No subcategories available" visible="{cat>/levels/2/noChildren}" class="noSubText"/>
 
              <Label text="Category 4"/>
              <Select id="selCategory4" selectedKey="{category4_ID}"
                      items="{cat>/levels/3/items}"
                      enabled="{cat>/levels/3/enabled}"
                      busy="{cat>/levels/3/busy}"
                      busyIndicatorDelay="0"
                      forceSelection="false"
                      width="100%"
                      change=".onCategoryChange">
                <core:Item key="{cat>ID}" text="{cat>name}"/>
              </Select>
              <Text text="No subcategories available" visible="{cat>/levels/3/noChildren}" class="noSubText"/>
 
              <Label text="Solution Category"/>
              <Select selectedKey="{solutionCategory_ID}"
                      items="{ path: '/LookupValues', sorter: [{ path: 'sequence' }], filters: [{ path: 'lookupType', operator: 'EQ', value1: 'SOLUTION_CATEGORY' }, { path: 'isActive', operator: 'EQ', value1: true }] }">
                <core:Item key="{ID}" text="{name}"/>
              </Select>
 
            </f:SimpleForm>
          </Panel>
 
          <!-- ===== 3. PROCESSING DATA ===== -->
          <Panel class="sectionCard" headerText="Processing Data" expandable="true" expanded="true">
            <f:SimpleForm editable="{ui>/formEditable}" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
 
              <Label text="Status"/>
              <ComboBox selectedKey="{status_ID}" enabled="{ui>/formEditable}"
                        items="{ path: '/LookupValues', sorter: [{ path: 'sequence' }], filters: [{ path: 'lookupType', operator: 'EQ', value1: 'STATUS' }, { path: 'isActive', operator: 'EQ', value1: true }] }">
                <core:Item key="{ID}" text="{name}"/>
              </ComboBox>
 
              <Label text="Impact" required="true"/>
              <ComboBox selectedKey="{impact_ID}" enabled="{ui>/formEditable}"
                        items="{ path: '/LookupValues', sorter: [{ path: 'sequence' }], filters: [{ path: 'lookupType', operator: 'EQ', value1: 'IMPACT' }, { path: 'isActive', operator: 'EQ', value1: true }] }">
                <core:Item key="{ID}" text="{name}"/>
              </ComboBox>
 
              <Label text="Urgency" required="true"/>
              <ComboBox selectedKey="{urgency_ID}" enabled="{ui>/formEditable}"
                        items="{ path: '/LookupValues', sorter: [{ path: 'sequence' }], filters: [{ path: 'lookupType', operator: 'EQ', value1: 'URGENCY' }, { path: 'isActive', operator: 'EQ', value1: true }] }">
                <core:Item key="{ID}" text="{name}"/>
              </ComboBox>
 
              <Label text="Recommended Priority"/>
              <Input value="{recommendedPriority/name}" editable="false" placeholder="Auto-suggested"/>
 
              <Label text="Priority" required="true"/>
              <ComboBox selectedKey="{priority_ID}" enabled="{ui>/formEditable}"
                        items="{ path: '/LookupValues', sorter: [{ path: 'sequence' }], filters: [{ path: 'lookupType', operator: 'EQ', value1: 'PRIORITY' }, { path: 'isActive', operator: 'EQ', value1: true }] }">
                <core:Item key="{ID}" text="{name}"/>
              </ComboBox>
 
              <Label text="IRT Status"/>
              <Select selectedKey="{irtStatus_ID}" forceSelection="false" enabled="{ui>/formEditable}"
                      items="{ path: '/LookupValues', sorter: [{ path: 'sequence' }], filters: [{ path: 'lookupType', operator: 'EQ', value1: 'IRT_STATUS' }, { path: 'isActive', operator: 'EQ', value1: true }] }">
                <core:Item key="{ID}" text="{name}"/>
              </Select>

              <Label text="MPT Status"/>
              <Select selectedKey="{mptStatus_ID}" forceSelection="false" enabled="{ui>/formEditable}"
                      items="{ path: '/LookupValues', sorter: [{ path: 'sequence' }], filters: [{ path: 'lookupType', operator: 'EQ', value1: 'MPT_STATUS' }, { path: 'isActive', operator: 'EQ', value1: true }] }">
                <core:Item key="{ID}" text="{name}"/>
              </Select>

              <Label text="SLA"/>
              <ObjectStatus
                text="{parts: ['priority/code','createdAt','firstResponseAt','completedAt'], formatter: '.formatSlaText'}"
                state="{parts: ['priority/code','createdAt','firstResponseAt','completedAt'], formatter: '.formatSlaState'}"/>
 
            </f:SimpleForm>
          </Panel>
 
          <!-- ===== 4. DATES ===== -->
          <Panel class="sectionCard" headerText="Dates" expandable="true" expanded="true">
            <f:SimpleForm editable="{ui>/formEditable}" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
 
              <Label text="Created"/>
              <Input value="{path: 'createdAt', formatter: '.formatDateTime'}" editable="false"/>
 
              <Label text="First Response By"/>
              <DateTimePicker editable="{ui>/formEditable}"
                value="{path: 'firstResponseAt', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: { V4: true }}"/>
 
              <Label text="Due By"/>
              <DateTimePicker editable="{ui>/formEditable}"
                value="{path: 'dueAt', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: { V4: true }}"/>

              <Label text="Completed On"/>
              <DateTimePicker editable="{ui>/formEditable}"
                value="{path: 'completedAt', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: { V4: true }}"/>
 
            </f:SimpleForm>
          </Panel>
 
          <!-- ===== 5. SYSTEM &amp; RELATIONSHIPS ===== -->
          <Panel class="sectionCard" headerText="System &amp; Relationships" expandable="true" expanded="true">
            <f:SimpleForm editable="{ui>/formEditable}" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
 
              <Label text="System"/>
              <Select selectedKey="{system_ID}" forceSelection="false" enabled="{ui>/formEditable}"
                      items="{ path: '/Systems', parameters: { $orderby: 'name' } }">
                <core:Item key="{ID}" text="{name}"/>
              </Select>

              <Label text="Software Component"/>
              <Select selectedKey="{softwareComponent_ID}" forceSelection="false" enabled="{ui>/formEditable}"
                      items="{ path: '/SoftwareComponents', parameters: { $orderby: 'name' } }">
                <core:Item key="{ID}" text="{name}"/>
              </Select>

              <Label text="Software Version"/>
              <Input value="{softwareVersion}" editable="{ui>/formEditable}"/>

              <Label text="Support Package"/>
              <Input value="{path: 'supportPackage', type: 'sap.ui.model.type.Integer'}" editable="{ui>/formEditable}"/>

              <Label text="Related RFC"/>
              <Input value="{relatedRFC}"/>
 
              <Label text="Configuration Item"/>
              <Select selectedKey="{configurationItem_ID}" forceSelection="false" enabled="{ui>/formEditable}"
                      items="{ path: '/ConfigurationItems', parameters: { $orderby: 'name' } }">
                <core:Item key="{ID}" text="{name}"/>
              </Select>
 
            </f:SimpleForm>
          </Panel>
 
        </VBox>
 
        <!-- ===== 6. DESCRIPTION ===== -->
        <VBox id="secDescription">
          <Panel class="sectionCard" headerText="Description" expandable="true" expanded="true">
            <Label text="Full Description" required="true"/>
            <TextArea rows="10" width="100%" editable="{ui>/formEditable}"
              growing="true" growingMaxLines="25"
              value="{description}"
              placeholder="Enter detailed technical notes and ticket analysis..."/>
          </Panel>
        </VBox>
 
        <!-- ===== 7. ATTACHMENTS ===== -->
        <VBox id="secAttachments">
          <Panel class="sectionCard" headerText="Attachments" expandable="true" expanded="true">
            <upload:UploadSet
              id="attachmentUploadSet"
              instantUpload="false"
              uploadEnabled="{ui>/formEditable}"
              terminationEnabled="true"
              showIcons="true"
              afterItemAdded=".onAttachmentAdded"
              afterItemRemoved=".onAttachmentRemove"
              noDataText="No attachments queued"
              noDataDescription="Drag files here or use Upload to attach them."/>
            <Text text="Maximum file size: 50MB. Supported: JPG, PNG, PDF, DOCX, XLSX" class="sapUiSmallMarginTop"/>
          </Panel>
        </VBox>
 
        <!-- HISTORY -->
        <VBox id="secHistory">
          <VBox class="sectionCard">
            <Text text="CHANGE HISTORY" class="sectionPill"/>
            <List id="historyTimeline" items="{hist>/list}" showSeparators="None" class="timelineList" noDataText="No changes recorded yet.">
              <CustomListItem>
                <HBox class="timelineRow">
                  <core:Icon src="sap-icon://edit" class="timelineDot"/>
                  <VBox class="timelineBody">
                    <HBox justifyContent="SpaceBetween">
                      <Text text="Ticket Updated" class="timelineTitle"/>
                      <Text text="{path: 'hist>createdAt', formatter: '.formatDateTime'}" class="timelineDate"/>
                    </HBox>
                    <Text text="{parts: ['hist>fieldName', 'hist>oldValue', 'hist>newValue'], formatter: '.formatHistoryText'}" class="timelineText"/>
                    <Text text="{path: 'hist>changedBy', formatter: '.formatChangedBy'}" class="timelineUser"/>
                  </VBox>
                </HBox>
              </CustomListItem>
            </List>
          </VBox>
        </VBox>
 
    </VBox>
 
  </Page>
</mvc:View>
 
 